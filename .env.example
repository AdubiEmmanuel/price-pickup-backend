# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Comma-separated
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://price-pickup.vercel.app

# Database - preferred: a single connection URL
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to false for a local/Docker Postgres container without TLS
DB_SSL_REQUIRE=true

# Database - fallback if DATABASE_URL is not set (used only when DEBUG=True)
DB_NAME=price_pickup
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
